# Required by Docker Compose. Replace the password before deployment.
POSTGRES_DB=amber
POSTGRES_USER=amber_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional direct-server database location. Compose overrides these with its internal service address.
PGHOST=localhost
PGPORT=5432

# Optional host-facing ports. Container-to-container ports and network topology stay unchanged.
POSTGRES_HOST_PORT=5432
PORT=5000
CLIENT_HTTP_PORT=80

# Optional PostgreSQL client settings for the server.
PGSSL=false
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000

# Optional exchange-rate settings. Leave NBU_RATE_OVERRIDE unset to use the official NBU rate.
NBU_MAX_STALE_MS=604800000
# NBU_RATE_OVERRIDE=40.00

# Public client configuration. Vite bundles this value into browser assets.
VITE_API_BASE_URL=/api

# Optional: use a URL instead of the POSTGRES_* values when connecting to an external database.
# DATABASE_URL=postgresql://example_user:example_password@localhost:5432/amber
